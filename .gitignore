# Proyeccion regenerable (forma Q): se reconstruye del log durable, no se versiona.
*.db
*.db-journal
*.db-wal

# Python
__pycache__/
*.pyc
*.pyo

# Entorno virtual (regla F77): un venv NO es reubicable ni portable entre maquinas;
# se recrea con `C:/Python314/python -m venv venv` + `pip install -r requirements.txt`.
venv/
.venv/

# El durable NO vive aqui (vive en ../AEC, fuera de todo repo).
# Si alguien lo enlaza por error, que git no lo vea:
AEC/

# granos/ (los YAML-AEC, un grano por necesidad) SI se versionan: son la fuente
# de la consolidacion (analogo a sessions/ de concept-sediment). No se ignoran.
